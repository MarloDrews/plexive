# Required — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-secret-key-here

# Supabase PostgreSQL connection string — get from Supabase dashboard:
# Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase Storage — get from Supabase dashboard: Settings > API
# SUPABASE_URL is the project URL (e.g. https://xyz.supabase.co)
# SUPABASE_SERVICE_KEY is the service_role key (keep secret — never expose to frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Optional — enables "Sign in with Google". Create an OAuth 2.0 Client ID of
# type "Web application" in Google Cloud Console (APIs & Services > Credentials),
# add your frontend URL to "Authorized JavaScript origins", and paste the client
# id here. Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend. When unset,
# the /api/auth/google endpoint returns 503 and the Google button is hidden.
# GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# Optional — comma-separated list of allowed CORS origins for the frontend.
# Defaults to http://localhost:3000. Set to your real frontend URL(s) in
# production; never use "*".
FRONTEND_ORIGIN=http://localhost:3000

# Optional — comma-separated IPs/CIDRs of reverse proxies whose x-forwarded-proto
# header the WebSocket TLS gate should trust (SEC-004/SEC-029). Leave empty when
# there is no TLS-terminating proxy in front: the gate then trusts only a native
# wss handshake or a non-public peer. Set it to the proxy's address when one
# terminates TLS — the Pi deployment runs cloudflared on loopback, so:
# TRUSTED_PROXY_IPS=127.0.0.1

# Optional: set to 0 to skip create_all at boot (M146). The live DB schema is
# managed by the manual scripts/ migrations; boot DDL only creates missing
# tables on fresh databases and tolerates the concurrent-boot race either way.
# RUN_STARTUP_DDL=1

# Thumbnail generator (/api/thumbnails/*). All optional, but SET THE USER AGENT
# BEFORE GENERATING IN PRODUCTION: Nominatim's usage policy requires an
# identifying string with a contact address, and blocks IPs that omit it.
# THUMBNAIL_USER_AGENT=Plexive-Thumbnails/1.0 (you@example.com)
#
# Point at your own Nominatim instance to skip the public API's 1 req/s limit.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
#
# Server-side geometry simplification in degrees. Unset by default: the
# renderer simplifies in pixel space instead, which follows the zoom. Set it
# only if cached payload size matters more than coastline quality (Russia is
# 3.9 MB at full detail; most regions are a few KB).
# NOMINATIM_POLYGON_THRESHOLD=0.0005
#
# Basemap release tag, and where the downloaded caches live. Defaults put them
# under backend/data/ (gitignored, re-fetchable).
# NATURAL_EARTH_TAG=v5.1.2
# THUMBNAIL_BASEMAP_DIR=
# THUMBNAIL_CACHE_DIR=
#
# Caption font. Falls back to a system bold sans, then downloads Anton (OFL)
# into backend/data/fonts/ if the container has no fonts at all.
# THUMBNAIL_FONT_PATH=/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf
