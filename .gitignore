# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.db
backend/deepscroll.db.legacy_*
.env

# Node / Next.js
node_modules/
.next/
.env.local

# Performance audit artifacts
.perf/

# Verification artifacts (screenshots, scratch scripts, export checks)
.verify/

# Logs
*.log
.claude/skills/ui-ux-pro-max

# OS / Editor
.DS_Store
.vscode/
!.vscode/extensions.json
.idea/

# The generated posts left this repository on 2026-08-29 (batch D), so nothing
# writes here any more. The earlier run's batch artefacts this rule used to cover
# were deleted on 2026-08-29 and their directories went with them, so there is
# nothing left to un-ignore. This line STAYS anyway, for the reason that outlives
# them: it keeps a future batch run's artefacts from being committed by accident.
docs/content-structure/generated/*/_batches/

# User-uploaded content (runtime data, not source)
user_uploads/

# The rule-behaviour log the Stop hook writes (added 2026-09-02). Runtime data
# about how THIS machine's sessions went, not source: one record per refusal and
# one per session, plus the offsets that keep the read incremental. It is the
# only thing under .claude/ that a session writes to on every stop, and leaving
# it tracked would put a diff in front of the user at the end of every session.
.claude/rule-log/
