{
  "permissions": {
    "allow": [
      "WebFetch(domain:upload.wikimedia.org)",
      "PowerShell(Get-ChildItem c:\\\\Users\\\\marlo\\\\GitHub\\\\deepscroll\\\\frontend\\\\public\\\\seed-images\\\\ | Select-Object Name, @{N='KB';E={[math]::Round\\($_.Length/1KB\\)}})",
      "Skill(code-review)",
      "Skill(code-review:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push --force*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse_bash.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse_write.py\""
          }
        ]
      }
    ]
  }
}
