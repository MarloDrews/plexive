NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional — enables "Sign in with Google". Use the SAME OAuth 2.0 Web client id
# as the backend's GOOGLE_CLIENT_ID. When unset, the Google button is hidden.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# Closed beta (2026-08). HTTP Basic credentials for src/proxy.ts, which gates
# the whole web app. NOT NEXT_PUBLIC_ -- that prefix would inline the password
# into the client bundle it is protecting. Set both in the Vercel project
# (Production scope); Vercel's own Password Protection is not available on the
# Hobby plan for a production domain.
# Only enforced when NODE_ENV=production, so dev and build need neither.
# An unset BETA_PASSWORD in production denies everyone rather than waving them
# through, so a typo in the variable name cannot silently reopen the site.
# BETA_USER defaults to "plexive" when unset.
# BETA_USER=plexive
# BETA_PASSWORD=
